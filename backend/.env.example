PORT=5000
NODE_ENV=development

# MongoDB connection string (Atlas or local)
MONGO_URI=mongodb://127.0.0.1:27017/motosecure

# JWT
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d

# CORS - comma separated list of allowed origins
CLIENT_ORIGINS=http://localhost:5173,http://localhost:19006

# Default super admin (created by seed script)
SEED_SUPERADMIN_EMAIL=admin@motosecure.cm
SEED_SUPERADMIN_PASSWORD=ChangeMe123!
