PORT=5000
NODE_ENV=development

# MongoDB connection string (use a SEPARATE database/cluster per environment)
MONGO_URI=mongodb://127.0.0.1:27017/motosecure

# JWT: at least 32 random characters, e.g.  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# CORS: comma separated list of allowed web origins (no wildcard)
CLIENT_ORIGINS=http://localhost:5173

# Number of reverse-proxy hops in front of the API (Render = 1)
TRUST_PROXY=1

# Password hashing cost (bcrypt rounds)
BCRYPT_ROUNDS=12

# Outgoing email for password reset (Gmail App Password, not the account password)
EMAIL_USER=
EMAIL_APP_PASSWORD=
FRONTEND_URL=http://localhost:5173

# Demo seeding only (see seed/seed.js; never seed a database holding real data)
SEED_SUPERADMIN_EMAIL=admin@motosecure.cm
SEED_SUPERADMIN_PASSWORD=
