{
  "name": "motosecure-backend",
  "version": "1.0.0",
  "description": "MotoSecure API - multi-tenant motorcycle transport & security platform for Cameroon",
  "main": "server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "seed": "node seed/seed.js",
